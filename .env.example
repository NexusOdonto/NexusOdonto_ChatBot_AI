# Configuración del Proveedor LLM ("openai" o "gemini")
LLM_PROVIDER="openai"

# OpenAI
OPENAI_API_KEY="sk-proj-tu-llave-secreta-de-openai-aqui"
OPENAI_MODEL="gpt-3.5-turbo"

# Google Gemini (obtén tu clave en https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Embeddings ("openai" o "gemini")
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"


QDRANT_URL="http://localhost:6333"

EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_INSTANCE_NAME="clinica_odonto"
EVOLUTION_API_KEY="CLAVE_SECRETA_ODONTO_2026"
EVOLUTION_API_TIMEOUT=10.0
WEBHOOK_SECRET="SECRETO_COMPARTIDO_CON_EVOLUTION"
WEBHOOK_SIGNATURE_HEADER="x-webhook-signature"

# Local: host port 5170. Docker Compose overrides this to http://odontologia_api:8080/api/v1
DOTNET_API_URL="http://localhost:5170/api/v1"
DOTNET_AUTH_LOGIN="usuario_bot@nexusodonto.com"
DOTNET_AUTH_PASSWORD="tu_password_seguro_aqui"
AGENT_INTERNAL_SECRET="TOKEN_SECRETO_INTERNO_NET_2026"
DOTNET_API_TIMEOUT=10.0
POSTGRES_CHECKPOINT_URL="postgresql://bot_user:bot_password@localhost:5433/bot_memory"
EVOLUTION_SEND_DELAY_MS=400

# Recordatorios diarios de citas del día siguiente
REMINDER_SCHEDULE_HOUR=8
REMINDER_SCHEDULE_MINUTE=0
REMINDER_TIMEZONE="America/Bogota"
RAG_MIN_CONFIDENCE=0.65
RAG_CANDIDATE_COUNT=5
RERANKER_MODEL="cross-encoder/mmarco-mMiniLMv2-L12-H384-v1"

# Portal Web de Pacientes
WEB_PORTAL_URL="https://nexusodonto.chatcampuslands.com/login"
